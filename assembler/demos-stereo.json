[
  {
    "id": "stereo-time-attack",
    "title": "V15: 立体タイムアタック（SNS収録用）",
    "summary": "学習タブ→⏱ 立体タイムアタック。回す操作では立体異性体が変わらず（鏡像のまま）、⇄ 鏡像の入れ替えでだけ立体が反転して完成する。フィッシャー投影のきまりをゲームで見せる。操作は回転CW／回転ACW／鏡像の入れ替えの3つ（v343）。ナレーションは 2026-08-01 に新しい3ボタンへ合わせて書き直し・再収録ずみ。wait は実収録の --events から詰めてある。video-scripts/V15.md",
    "sns": true,
    "steps": [
      {
        "caption": "左と同じ立体異性体を作れ",
        "actions": [
          {
            "type": "button",
            "selector": ".mode-tab[data-mode=\"learn\"]"
          },
          {
            "type": "wait",
            "ms": 400
          },
          {
            "type": "button",
            "selector": "#learn-acc-quiz>summary"
          },
          {
            "type": "wait",
            "ms": 400
          },
          {
            "type": "button",
            "selector": "#btn-time-attack"
          },
          {
            "type": "wait",
            "ms": 1800
          }
        ]
      },
      {
        "caption": "まず、図を回してみる",
        "actions": [
          {
            "type": "button",
            "selector": "#btn-ta-rot90ccw"
          },
          {
            "type": "wait",
            "ms": 2730
          }
        ]
      },
      {
        "caption": "回しても分子は変わらない（鏡像のまま）",
        "actions": [
          {
            "type": "button",
            "selector": "#btn-ta-rot90cw"
          },
          {
            "type": "wait",
            "ms": 5510
          }
        ]
      },
      {
        "caption": "⇄ 鏡像を入れ替えると立体が反転する",
        "actions": [
          {
            "type": "button",
            "selector": "#btn-ta-swap"
          },
          {
            "type": "wait",
            "ms": 4220
          }
        ]
      },
      {
        "caption": "完成！ タイムと手数が出る",
        "actions": [
          {
            "type": "wait",
            "ms": 12000
          }
        ]
      }
    ]
  },
