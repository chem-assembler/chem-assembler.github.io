[
  {
    "id": "isomer-c2h6o",
    "title": "V2: 同じ分子式C₂H₆Oで別の物質（SNS収録用）",
    "summary": "エタノール（C-C-O）を作って名称表示→全消去→酸素を真ん中にしてジメチルエーテル。名称チップに出る分子式が同じことが見せ場。video-scripts/V2.md",
    "sns": true,
    "steps": [
      {
        "caption": "炭素・炭素・酸素をつなぐと…",
        "actions": [
          { "type": "button", "selector": "#btn-tool-select" },
          { "type": "button", "selector": ".atom-btn.atom-c" },
          { "type": "click", "x": 420, "y": 294 },
          { "type": "click", "x": 462, "y": 294 },
          { "type": "button", "selector": ".atom-btn.atom-o" },
          { "type": "click", "x": 504, "y": 294 },
          { "type": "wait", "ms": 1600 }
        ]
      },
      {
        "caption": "エタノール（お酒の成分）",
        "actions": [
          { "type": "wait", "ms": 1400 }
        ]
      },
      {
        "caption": "原子の数はそのまま、つなぎ方だけ変える",
        "actions": [
          { "type": "button", "selector": "#btn-clear-all" },
          { "type": "wait", "ms": 700 },
          { "type": "button", "selector": ".atom-btn.atom-c" },
          { "type": "click", "x": 420, "y": 294 },
          { "type": "button", "selector": ".atom-btn.atom-o" },
          { "type": "click", "x": 462, "y": 294 },
          { "type": "button", "selector": ".atom-btn.atom-c" },
          { "type": "click", "x": 504, "y": 294 },
          { "type": "wait", "ms": 1600 }
        ]
      },
      {
        "caption": "ジメチルエーテル（常温では気体）",
        "actions": [
          { "type": "wait", "ms": 1800 }
        ]
      },
      {
        "caption": "同じC₂H₆O、でも別の物質",
        "actions": [
          { "type": "button", "selector": "#btn-reset-view" },
          { "type": "wait", "ms": 1800 }
        ]
      }
    ]
  },
  {
    "id": "intro-draw",
    "title": "V1: ノートに書く感覚で描ける（SNS収録用）",
    "summary": "炭素の配置→自動結合→二重結合→ベンゼン環→OH→フェノール（名称表示）→Undo。video-scripts/V1.md の実演部",
    "sns": true,
    "steps": [
      {
        "caption": "タップで炭素が置ける",
        "actions": [
          { "type": "button", "selector": "#btn-tool-select" },
          { "type": "click", "x": 420, "y": 294 },
          { "type": "click", "x": 462, "y": 294 },
          { "type": "click", "x": 462, "y": 336 }
        ]
      },
      {
        "caption": "結合をタップすると二重結合に",
        "actions": [
          { "type": "clickBond", "x": 441, "y": 294 },
          { "type": "wait", "ms": 700 },
          { "type": "clickBond", "x": 441, "y": 294 },
          { "type": "clickBond", "x": 441, "y": 294 }
        ]
      },
      {
        "caption": "ベンゼン環はワンタップ",
        "actions": [
          { "type": "button", "selector": "#btn-clear-all" },
          { "type": "wait", "ms": 400 },
          { "type": "button", "selector": ".mod-btn[data-module=\"benzene\"]" },
          { "type": "click", "x": 420, "y": 294 }
        ]
      },
      {
        "caption": "OHを付けると…名前が出る！",
        "actions": [
          { "type": "button", "selector": ".mod-btn[data-module=\"oh\"]" },
          { "type": "hover", "x": 455, "y": 294 },
          { "type": "wait", "ms": 500 },
          { "type": "click", "x": 455, "y": 294 },
          { "type": "wait", "ms": 1400 }
        ]
      },
      {
        "caption": "間違えても1タップで戻せる",
        "actions": [
          { "type": "button", "selector": ".atom-btn.atom-c" },
          { "type": "click", "x": 437, "y": 366 },
          { "type": "wait", "ms": 500 },
          { "type": "undo" },
          { "type": "wait", "ms": 600 }
        ]
      },
      {
        "caption": "無料・インストール不要",
        "actions": [
          { "type": "button", "selector": "#btn-reset-view" },
          { "type": "wait", "ms": 1600 }
        ]
      }
    ]
  }
]
